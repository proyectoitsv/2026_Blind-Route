<?xml version="1.0" encoding="utf-8"?>
<!--
  Ícono adaptable de BlindRoute (Android 8 y posteriores), el mismo para las
  dos apps.
    · Fondo: #0D1117 liso, el fondo de la app.
    · Primer plano: el pin y la S del logo (assets/icon/logo_fuente.png), con
      el cuadrado del logo calzado en los 72 dp visibles. El glifo llega a
      28 dp del centro, adentro de la zona segura (círculo de 66 dp).
    · Monocromática: la silueta del pin y la S, para los íconos temáticos de
      Android 13.
  Los PNG de cada mipmap salen de un script que no está en el repositorio
  (ver el Registro del 2026-11-04 en las notas locales).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
